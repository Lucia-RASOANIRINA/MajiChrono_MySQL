# Configuration locale pour XAMPP MySQL.
ENVIRONMENT=dev
# La page phpMyAdmin n'est pas une URL de connexion. Utilisez les parametres
# fournis par l'hebergeur, sans les committer :
# DATABASE_URL=mysql+pymysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/nellfaag_majichrono
# Ou utilisez les variables DB_* du panneau d'hebergement :
# DB_HOST=127.0.0.1
# DB_NAME=nellfaag_majichrono
# DB_USER=nellfaag_majichrono
# DB_PASS=
# DB_PORT=3306
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/majichrono_mysql

# Remplacez la valeur DATABASE_URL ci-dessus par la chaine fournie par
# l'hebergeur, par exemple :
# DATABASE_URL=mysql+pymysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/nellfaag_majichrono
#
# En developpement, le code OTP est journalise et renvoye par l'API de test.
OTP_DEBUG_CODES=true
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@majichrono.mg
MAIL_FROM_NAME=MajiChrono

SMS_API_KEY=
SMS_SENDER=MajiChrono
MAJIPAY_API_KEY=
