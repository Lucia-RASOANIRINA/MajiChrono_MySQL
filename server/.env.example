# Copiez en `.env` et remplissez. `.env` n'est jamais versionne.

ENVIRONMENT=dev

# --- Base de donnees --------------------------------------------------------
# Vide = SQLite local. En production DirectAdmin, utilisez les variables DB_*.
# avec les valeurs de la base MySQL/MariaDB creee dans le panneau.
# DATABASE_URL=postgresql+psycopg://user:mdp@ep-xxx-pooler.eu-central-1.aws.neon.tech/majichrono?sslmode=require
DATABASE_URL=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

# Au moins 32 caracteres hors developpement, sinon le serveur refuse de demarrer.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- E-mail (SMTP) ----------------------------------------------------------
# Pour les tests locaux uniquement : mettez OTP_DEBUG_CODES=true pour ne pas
# envoyer d'e-mail réel et recevoir le code dans la réponse debugCode.
OTP_DEBUG_CODES=true
# En mode test, le code est renvoye dans `debugCode` et journalise.
#
# A) Gmail — utilisable aujourd'hui, sans nouveau compte.
#    ATTENTION : le mot de passe du compte NE MARCHE PAS. Google exige un
#    « mot de passe d'application », a creer sur
#    https://myaccount.google.com/apppasswords apres avoir active la validation
#    en deux etapes. ~500 envois/jour : suffisant pour la recette, pas pour la
#    production.
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=rasoanirinambolatina8@gmail.com
#      SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#
# B) Resend — pour la production. 3 000 envois/mois, sans carte bancaire.
#      SMTP_HOST=smtp.resend.com
#      SMTP_PORT=587
#      SMTP_USER=resend
#      SMTP_PASSWORD=re_votre_cle
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Alias accepte par la configuration fournie par l'hebergeur.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=rasoanirinambolatina8@gmail.com
MAIL_FROM_NAME=MajiChrono

# --- SMS (mAPI Madagascar) --------------------------------------------------
# LAISSEZ VIDE tant que vous n'etes pas pret a consommer le quota d'essai.
# Vide = le code part dans le journal, jamais sur le reseau.
#
#   1. Ouvrir un compte sur https://messaging.mapi.mg/subscriber
#   2. Recuperer la cle d'API
#   3. Faire declarer `MajiChrono` comme nom d'expediteur (11 caracteres max)
#
# Le premier envoi reel doit etre un geste decide, pas un effet de bord.
SMS_API_KEY=
SMS_SENDER=MajiChrono
