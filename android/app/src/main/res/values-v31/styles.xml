<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 et au-dela imposent leur propre ecran de demarrage. On y pose
      le logo MajiChrono sur le bleu de la charte. Le drawable est **marge de
      transparent** pour que le dessin tienne dans le cercle inscrit du masque
      systeme : il n'est donc jamais rogne. Et l'on ne peint **aucune** couleur
      de fond d'icone : le bleu de l'ecran transparait a la place, si bien
      qu'aucune pastille ronde n'apparait autour du logo.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
