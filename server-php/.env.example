# Copiez en `.env` et remplissez. `.env` n'est jamais versionne.
#
# Ce fichier sert au developpement local, hors du serveur DirectAdmin (d'ou
# DB_HOST sur le nom public du domaine). Pour un paquet a deployer, voir
# .env.production.example -- les scripts build-*.ps1 utilisent
# .env.production automatiquement.

APP_NAME=MajiChrono
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La base hebergee (MySQL/MariaDB partagee avec le site web PHP existant)
# reste la source de verite. `artisan migrate` ne doit JAMAIS tourner sur
# cette connexion : les tables existent deja et ne nous appartiennent pas
# entierement (le site web PHP les lit aussi).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Pas de tables sessions/cache/jobs a nous dans le schema existant : on evite
# le pilote "database" par defaut de Laravel pour ne rien avoir a y creer.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Meme secret que le backend FastAPI (server/.env), pour que les jetons deja
# emis restent valides pendant la transition entre les deux backends.
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_DEBUG_CODES=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
