# Copiez en `.env.production` et remplissez. `.env.production` n'est jamais
# versionne (c'est le fichier reellement uploade sur DirectAdmin, sous le nom
# `.env`, par build-deploy-zip.ps1 / build-natural-zip.ps1).
#
# DB_HOST=localhost et non le nom public du domaine : depuis le serveur
# DirectAdmin lui-meme, se connecter via son propre nom d'hote externe est
# refuse par MySQL (constate le 2026-09-16). Seul le developpement local
# (hors du serveur) a besoin du nom public -- voir .env.example pour cet
# usage-la.

APP_NAME=MajiChrono
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://majichronomobile.majitech.mg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

JWT_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_DEBUG_CODES=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
